{
  "name": "theoros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A board of the EVE Online space read from ESI: one star system a project, drawn by skene.",
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate",
    "build": "tsc -b && vite build",
    "prebuild": "npm run generate",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "npm run generate",
    "typecheck": "tsc -b",
    "frame": "node tools/frame.mjs",
    "preinstall": "node tools/frame.mjs",
    "licenses": "node tools/licenses.mjs",
    "deploy": "./deploy.sh",
    "postbuild": "node tools/licenses.mjs --notices dist/third-party.txt",
    "generate": "tsx tools/systems.ts && node tools/board.mjs",
    "board": "node tools/board.mjs",
    "systems": "tsx tools/systems.ts",
    "capture": "tsx tools/capture.ts",
    "demo": "node tools/demo.mjs",
    "voice": "node tools/voice.mjs",
    "dub": "node tools/voice.mjs && node tools/dub.mjs"
  },
  "dependencies": {
    "@ssccsorg/skene-board": "file:./skene/packages/board",
    "@ssccsorg/skene-frame": "file:./skene/packages/frame",
    "@ssccsorg/skene-kernel": "file:./skene/packages/kernel",
    "@ssccsorg/skene-ui": "file:./skene/packages/ui",
    "@ssccsorg/skene-view-graph": "file:./skene/packages/view-graph",
    "@ssccsorg/skene-view-media": "file:./skene/packages/view-media",
    "@ssccsorg/skene-view-shell": "file:./skene/packages/view-shell",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metasmile/theoros.git"
  }
}
